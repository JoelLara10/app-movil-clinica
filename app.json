{
  "expo": {
    "name": "INEO Hospital",
    "slug": "ineo-hospital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ineo.hospital",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.ineo.hospital",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#667eea"
      },
      "permissions": [
        "DOWNLOAD_WITHOUT_NOTIFICATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "API_URL": "https://api-hospital-cq3e.onrender.com/api/v1",
      "eas": {
        "projectId": "af5c4bd9-8c79-4271-8eea-6485e978d713"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#667eea"
        }
      ]
    ]
  }
}
