{
  "name": "app-movil-clinica",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --experimental-vm-modules --test tests/*.test.cjs",
    "check": "npm test && npx expo-doctor && npx expo export --platform web",
    "start:qa": "node scripts/expo-qa.cjs start",
    "export:qa": "node scripts/expo-qa.cjs export --platform web --output-dir dist-qa",
    "lint": "oxlint --deny no-dupe-keys --deny no-undef --deny no-unreachable --deny no-unsafe-finally --deny const-comparisons App.js src scripts tests",
    "security:review": "python ci/security_review.py --out reports/security/local",
    "security:policy": "python -m unittest discover -s ci -p test_security_gate.py"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/stack": "^7.12.1",
    "axios": "^1.21.0",
    "expo": "~57.0.31",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "moment": "^2.30.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~2.33.1",
    "react-native-paper": "^5.15.3",
    "react-native-pdf": "^7.0.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.17.0",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "oxlint": "1.90.0"
  },
  "overrides": {
    "follow-redirects": "1.16.2",
    "node-forge": "1.4.2",
    "@expo/cli": {
      "zod": "4.6.7"
    }
  }
}
